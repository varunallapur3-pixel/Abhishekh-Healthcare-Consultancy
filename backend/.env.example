# ==============================================================================
# Environment Configuration Template
# Project: Abhishekh Healthcare Consultancy - Backend Service
# ==============================================================================

# Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Anti-Spam Rate Limiting Settings
# Allow up to 5 submissions per 10 minutes (600 seconds) per IP
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=600

# Supabase PostgreSQL Settings
# Obtain these from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
